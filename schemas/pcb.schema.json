{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiresketch.dev/schemas/pcb-1.0.schema.json",
  "title": "WireSketch PCB description",
  "description": "A portable PCB visual and interface/pin definition used by WireSketch.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "kind", "version", "id", "name", "coordinateSystem", "image", "imageSize", "source", "interfaces"],
  "properties": {
    "schema": { "const": "urn:wiresketch:schema:pcb:1.0", "description": "Stable format identifier. Never translate or modify it." },
    "schemaVersion": { "const": "1.1.0" },
    "kind": { "const": "wiresketch/pcb" },
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "default": "", "description": "Human/AI-readable purpose, restrictions, voltage notes, or board revision." },
    "coordinateSystem": { "$ref": "#/$defs/coordinateSystem" },
    "image": {
      "description": "Embedded PCB image as a data URL. It may be null only when an external renderer intentionally omits the visual asset.",
      "type": ["string", "null"]
    },
    "imageSize": { "$ref": "#/$defs/imageSize" },
    "source": { "enum": ["image", "generated"], "description": "Whether image is uploaded or generated by WireSketch." },
    "backgroundTransparency": { "$ref": "#/$defs/backgroundTransparency" },
    "generated": { "$ref": "#/$defs/generated" },
    "interfaces": {
      "type": "array",
      "description": "Physical connectors on this board. Interface IDs must be unique within the board.",
      "items": { "$ref": "#/$defs/interface" }
    }
  },
  "allOf": [
    { "if": { "properties": { "source": { "const": "generated" } } }, "then": { "required": ["generated"] } }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "axisX", "axisY", "regionUnit"],
      "properties": {
        "origin": { "const": "top-left" },
        "axisX": { "const": "right" },
        "axisY": { "const": "down" },
        "regionUnit": { "const": "normalized" }
      }
    },
    "imageSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "unit"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "unit": { "const": "px" }
      }
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "color"],
      "properties": {
        "width": { "type": "integer", "minimum": 120, "maximum": 2400 },
        "height": { "type": "integer", "minimum": 80, "maximum": 1600 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "backgroundTransparency": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional chroma-key color selected from an uploaded image and made transparent for display and export.",
      "required": ["color", "tolerance"],
      "properties": {
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "tolerance": { "type": "integer", "minimum": 0, "maximum": 64 }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "description": "Normalized interface bounding box. x/y are its top-left corner; w/h are its size. Each value is relative to image width/height. x+w and y+h must not exceed 1.",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "description", "rect", "pins"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "type": { "type": "string", "minLength": 1, "maxLength": 40, "description": "Protocol/family such as power, uart, i2c, spi, usb, gpio, or generic." },
        "description": { "type": "string", "default": "" },
        "rect": { "$ref": "#/$defs/region" },
        "rotation": {
          "type": "integer",
          "enum": [0, 90, 180, 270],
          "default": 0,
          "description": "Clockwise connector rotation in image coordinates. At 0 degrees Pin 1 is on the left; 90 places it on top; 180 on the right; 270 on the bottom."
        },
        "pins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "description": "Ordered physical pin names. Array index 0 is Pin 1, index 1 is Pin 2, and so on. Do not alphabetically sort this array.",
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    }
  }
}
