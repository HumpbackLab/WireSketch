      "generated": { "width": 360, "height": 220, "color": "#245069" },
      "interfaces": [
        { "id": "if_uart", "name": "UART", "type": "uart", "description": "3.3 V TTL。", "rect": { "x": 0.02, "y": 0.25, "w": 0.14, "h": 0.5 }, "rotation": 90, "pins": ["RXD", "TXD", "GND"] }
      ]
